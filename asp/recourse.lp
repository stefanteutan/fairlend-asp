% =====================================================================
% Feature B - actionable recourse for one denied applicant (clingo)
%
% Facts generated by Python for each applicant:
%   val(F,V)        current value of an immutable feature
%   val0(F,V)       current value of an actionable feature
%   opt(F,V,Cost)   a possible new value of actionable feature F
%   actionable(F)
% plus the decision tree compiled to rules (leaf/1, leafp/2) and the
% policy chosen by Feature A (thr/1, dcap/1, lcap/1, raw values).
%
% Units: income and loan amount in $1000, DTI in %, LTV in 1/100 %.
% Race, sex, ethnicity and age are never facts here, so they can never
% be part of a recourse.
% =====================================================================

% choose exactly one new value for every actionable feature
1 { pick(F,V,Cost) : opt(F,V,Cost) } 1 :- actionable(F).
val(F,V) :- pick(F,V,_).

% LTV follows the loan amount: a smaller loan means a smaller LTV
val(ltv,L) :- val0(ltv,L0), val(loan_amount_k,A), val0(loan_amount_k,A0),
              A0 > 0, L = L0*A/A0.

% the policy denies if the tree score is too low or a cap is exceeded
deny :- leaf(K), leafp(K,P), thr(T), P < T.
deny :- val(dti,D),  dcap(C), D > C.
deny :- val(ltv,L),  lcap(C), L > C.
:- deny.

% the cheapest change wins
#minimize { Cost,F : pick(F,_,Cost) }.

#show pick/3.
#show leaf/1.
