% =====================================================================
% Feature A - choose a fair decision policy (clingo)
%
% A policy = (score threshold, DTI cap, LTV cap). Every candidate is
% evaluated with rules and aggregates; the solver picks the
% policy with the highest accuracy that satisfies every requirement
% that is switched on. If no policy works, Python asks clingo for an
% unsatisfiable core and shrinks it to a MUS.
%
% Facts generated by Python from the training data:
%   cell(C)       a group of applicants that look the same to the policy
%   cnt(C,K)      number of applicants in cell C
%   y(C,Y)        historical decision (1 = approved, 0 = denied)
%   leafp(C,P)    approval score of the decision-tree leaf, per mille
%   dtib(C,B)     DTI bin: 0 <=43%, 1 <=50%, 2 <=60%, 3 >60%
%   ltvb(C,B)     LTV bin: 0 <=80%, 1 <=90%, 2 <=95%, 3 <=100%, 4 >100%
%   in(C,G)       cell C belongs to demographic group G
%   ref(G,R)      group G is compared against reference group R
%   thr_opt(T). dcap_opt(B). lcap_opt(B).   possible policy values
%   req(R)        names of the requirements (used for the MUS)
% =====================================================================

#const air_min = 800.     % adverse impact ratio >= 0.8 (four-fifths rule)
#const eo_max  = 50.      % true-positive-rate gap <= 0.05
#const acc_min = 850.     % accuracy >= 85%
#const dti_max_bin = 1.   % bank rule: DTI cap must be 50% or stricter

% ---- every possible policy, and its decisions (computed for all of them) ----
pol(T,D,L) :- thr_opt(T), dcap_opt(D), lcap_opt(L).
approve(T,D,L,C) :- pol(T,D,L), cell(C), leafp(C,P), P >= T,
                    dtib(C,B1), B1 <= D, ltvb(C,B2), B2 <= L.

% ---- statistics per policy and group (per mille) ----
group(G) :- in(_,G).
n(G,N)   :- group(G), N = #sum{ K,C : in(C,G), cnt(C,K) }.
pos(G,N) :- group(G), N = #sum{ K,C : in(C,G), cnt(C,K), y(C,1) }.
a(T,D,L,G,A)  :- pol(T,D,L), group(G), A = #sum{ K,C : in(C,G), cnt(C,K), approve(T,D,L,C) }.
tp(T,D,L,G,A) :- pol(T,D,L), group(G), A = #sum{ K,C : in(C,G), cnt(C,K), y(C,1), approve(T,D,L,C) }.
rate(T,D,L,G,R) :- a(T,D,L,G,A),  n(G,N),   N > 0, R = 1000*A/N.
tpr(T,D,L,G,R)  :- tp(T,D,L,G,A), pos(G,N), N > 0, R = 1000*A/N.

total(N) :- N = #sum{ K,C : cnt(C,K) }.
correct(T,D,L,M) :- pol(T,D,L), M = #sum{ K,C : cnt(C,K), approve(T,D,L,C), y(C,1) ;
                                           K,C : cnt(C,K), not approve(T,D,L,C), y(C,0) }.
acc(T,D,L,X) :- correct(T,D,L,M), total(N), X = 1000*M/N.

% ---- which requirement each policy breaks ----
breaks(T,D,L,air(G)) :- ref(G,R), rate(T,D,L,G,X), rate(T,D,L,R,Y), 1000*X < air_min*Y.
breaks(T,D,L,eo(G))  :- ref(G,R), tpr(T,D,L,G,X),  tpr(T,D,L,R,Y),  Y - X > eo_max.
breaks(T,D,L,accuracy) :- acc(T,D,L,X), X < acc_min.
breaks(T,D,L,dti_rule) :- pol(T,D,L), D > dti_max_bin.

% ---- the decision: choose exactly one policy ----
1 { choose(T,D,L) : pol(T,D,L) } 1.

% a requirement counts only if on(R) is assumed (this is what makes the MUS possible)
{ on(R) } :- req(R).
:- on(R), choose(T,D,L), breaks(T,D,L,R).

% ---- among valid policies, keep the most accurate one ----
#maximize { M : choose(T,D,L), correct(T,D,L,M) }.

thr(T) :- choose(T,_,_).  dcap(D) :- choose(_,D,_).  lcap(L) :- choose(_,_,L).
acc(X) :- choose(T,D,L), acc(T,D,L,X).
#show thr/1. #show dcap/1. #show lcap/1. #show acc/1.
